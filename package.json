{
  "name": "synapse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "pnpm --filter @synapse/server dev",
    "dev:web": "pnpm --filter @synapse/web dev",
    "dev:desktop": "pnpm --filter @synapse/desktop dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^25.3.2"
  }
}
