# ==================== 依赖与包管理器 ====================
# Node.js 依赖目录
node_modules/

# pnpm 相关
.pnpm-store/
.pnpm-debug.log

# npm/yarn 相关
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/


# ==================== 构建产物 ====================
# 通用构建输出
dist/
build/
out/
*.tsbuildinfo

# Vite 缓存
.vite/

# Electron 打包产物
release/
*.dmg
*.exe
*.AppImage


# ==================== 运行时数据与日志 ====================
# 日志文件
logs/
*.log

# 进程 ID 文件
.run/
*.pid

# Synapse 本地数据(含 SQLite 与 AI 产物)
apps/server/.synapse-data/


# ==================== 环境配置 ====================
# 环境变量文件(严禁提交,防止泄密)
.env
.env.local
.env.*.local

# 保留示例配置文件
!.env.example
!.env.*.example


# ==================== IDE 与编辑器 ====================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains 系列(IntelliJ IDEA、WebStorm 等)
.idea/
*.iml

# Vim/Neovim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*


